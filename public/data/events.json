{
  "events": [
    {
      "id": "jamin-welcome",
      "once": true,
      "when": [ { "type": "day-since-start", "gte": 1 } ],
      "do": [
        {
          "type": "send-mail",
          "sender": "Jamin",
          "titleKey": "jamin_letter_title",
          "bodyKey": "jamin_letter_body",
          "subst": { "name": "@callName", "cato": "@catoName" }
        }
      ]
    },
    {
      "id": "wood-milestone",
      "once": true,
      "when": [ { "type": "item-count", "item": "wood", "gte": 20 } ],
      "do": []
    },
    {
      "id": "jamin-rod-letter",
      "once": true,
      "when": [ { "type": "days-since-event", "id": "wood-milestone", "gte": 1 } ],
      "do": [
        {
          "type": "send-mail",
          "sender": "Jamin",
          "titleKey": "jamin_rod_title",
          "bodyKey": "jamin_rod_body",
          "subst": { "name": "@callName" }
        },
        { "type": "unlock", "id": "fishing-recipe-unlocked" }
      ]
    }
  ]
}
