{
  "schemaVersion": 1,
  "id": "game-hud",
  "name": "Game HUD",
  "type": "hud",
  "design": {
    "designAspectRatio": "9:16",
    "safeArea": { "top": 16, "right": 16, "bottom": 16, "left": 16 }
  },
  "entities": [
    {
      "id": "score-text",
      "kind": "text",
      "anchor": { "side": "top-left", "offsetX": 16, "offsetY": 16 },
      "layer": "base",
      "source": { "mode": "dynamic", "binding": "score", "prefix": "SCORE ", "fallback": "0" },
      "fontSize": 26,
      "color": "#ffffff",
      "align": "left"
    },
    {
      "id": "best-text",
      "kind": "text",
      "anchor": { "side": "top-right", "offsetX": -16, "offsetY": 16 },
      "layer": "base",
      "source": { "mode": "dynamic", "binding": "highScore", "prefix": "BEST ", "fallback": "0" },
      "fontSize": 20,
      "color": "#ffe066",
      "align": "right"
    },
    {
      "id": "lives-text",
      "kind": "text",
      "anchor": { "side": "top", "offsetX": 0, "offsetY": 18 },
      "layer": "base",
      "source": { "mode": "dynamic", "binding": "lives", "prefix": "❤ x ", "fallback": "3" },
      "fontSize": 22,
      "color": "#ff8fa3",
      "align": "center"
    },
    {
      "id": "pause-button",
      "kind": "icon-button",
      "anchor": { "side": "top-right", "offsetX": -16, "offsetY": 64 },
      "layer": "overlay",
      "label": "❚❚",
      "shape": "rounded-rect",
      "width": 56,
      "height": 48,
      "fillColor": "#3b3b5c",
      "textColor": "#ffffff"
    },

    { "id": "pause-overlay", "kind": "panel", "anchor": { "side": "center" }, "layer": "modal", "z": 0,
      "width": 720, "height": 1280, "backgroundColor": "#000000", "backgroundAlpha": 0.55,
      "role": "pause-dialog", "visible": false },
    { "id": "pause-box", "kind": "panel", "anchor": { "side": "center" }, "layer": "modal", "z": 1,
      "width": 420, "height": 460, "backgroundColor": "#2c2360", "backgroundAlpha": 0.96,
      "borderColor": "#8ab4ff", "borderWidth": 2, "borderRadius": 20,
      "role": "pause-dialog", "visible": false },
    { "id": "pause-title", "kind": "text", "anchor": { "side": "center", "offsetY": -170 }, "layer": "modal", "z": 2,
      "source": { "mode": "static", "text": "Game Paused" }, "fontSize": 36, "color": "#ffffff", "align": "center",
      "role": "pause-dialog", "visible": false },
    { "id": "resume-button", "kind": "icon-button", "anchor": { "side": "center", "offsetY": -70 }, "layer": "modal", "z": 2,
      "label": "Resume", "shape": "rounded-rect", "width": 260, "height": 60,
      "fillColor": "#3ddc84", "textColor": "#12321f",
      "role": "pause-dialog", "visible": false },
    { "id": "restart-button", "kind": "icon-button", "anchor": { "side": "center", "offsetY": 10 }, "layer": "modal", "z": 2,
      "label": "Restart", "shape": "rounded-rect", "width": 260, "height": 60,
      "fillColor": "#4fd1ff", "textColor": "#12321f",
      "role": "pause-dialog", "visible": false },
    { "id": "exit-button", "kind": "icon-button", "anchor": { "side": "center", "offsetY": 90 }, "layer": "modal", "z": 2,
      "label": "Exit game", "shape": "rounded-rect", "width": 260, "height": 60,
      "fillColor": "#ff6b6b", "textColor": "#3a0d0d",
      "role": "pause-dialog", "visible": false },

    { "id": "gameover-overlay", "kind": "panel", "anchor": { "side": "center" }, "layer": "modal", "z": 0,
      "width": 720, "height": 1280, "backgroundColor": "#000000", "backgroundAlpha": 0.6,
      "role": "gameover-dialog", "visible": false },
    { "id": "gameover-box", "kind": "panel", "anchor": { "side": "center" }, "layer": "modal", "z": 1,
      "width": 440, "height": 540, "backgroundColor": "#241a52", "backgroundAlpha": 0.97,
      "borderColor": "#ff8fa3", "borderWidth": 2, "borderRadius": 20,
      "role": "gameover-dialog", "visible": false },
    { "id": "gameover-title", "kind": "text", "anchor": { "side": "center", "offsetY": -220 }, "layer": "modal", "z": 2,
      "source": { "mode": "static", "text": "Game Over!" }, "fontSize": 38, "color": "#ff8fa3", "align": "center",
      "role": "gameover-dialog", "visible": false },
    { "id": "gameover-score", "kind": "text", "anchor": { "side": "center", "offsetY": -140 }, "layer": "modal", "z": 2,
      "source": { "mode": "dynamic", "binding": "score", "prefix": "Score: ", "fallback": "0" },
      "fontSize": 28, "color": "#ffffff", "align": "center",
      "role": "gameover-dialog", "visible": false },
    { "id": "gameover-best", "kind": "text", "anchor": { "side": "center", "offsetY": -95 }, "layer": "modal", "z": 2,
      "source": { "mode": "dynamic", "binding": "highScore", "prefix": "Best: ", "fallback": "0" },
      "fontSize": 24, "color": "#ffe066", "align": "center",
      "role": "gameover-dialog", "visible": false },
    { "id": "gameover-newbest", "kind": "text", "anchor": { "side": "center", "offsetY": -55 }, "layer": "modal", "z": 2,
      "source": { "mode": "dynamic", "binding": "newBestLabel", "fallback": "" },
      "fontSize": 22, "color": "#ffe066", "align": "center",
      "role": "gameover-dialog", "visible": false },
    { "id": "play-again-button", "kind": "icon-button", "anchor": { "side": "center", "offsetY": 40 }, "layer": "modal", "z": 2,
      "label": "Play Again", "shape": "rounded-rect", "width": 260, "height": 60,
      "fillColor": "#3ddc84", "textColor": "#12321f",
      "role": "gameover-dialog", "visible": false },
    { "id": "exit-button-2", "kind": "icon-button", "anchor": { "side": "center", "offsetY": 120 }, "layer": "modal", "z": 2,
      "label": "Exit game", "shape": "rounded-rect", "width": 260, "height": 60,
      "fillColor": "#ff6b6b", "textColor": "#3a0d0d",
      "role": "gameover-dialog", "visible": false }
  ]
}
